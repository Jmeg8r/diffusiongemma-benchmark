# Copy to .env and adjust for your machine.

# Model-weights cache. Defaults to the external "AI Education" drive because the
# internal disk is nearly full. Point this anywhere with ~40 GB free.
HF_HOME="/Volumes/AI Education/hf-cache"

# Local Claude CLI used as the blind LLM-as-judge for writing prompts.
# No API key needed — uses your logged-in claude session.
JUDGE_CLI=claude
